    {
        "id": "dc28b8d2d960b17c",
        "type": "function",
        "z": "fead62247fb3efa1",
        "name": "Procesar datos",
        "func": "// Botón \"Reiniciar estadísticas\"\nif (msg.topic === 'reset') {\n    context.set('s', null);\n    return [{ payload: null }, { payload: null }, { payload: [] }, null, null];\n}\nconst p = msg.payload;\nif (!p || typeof p !== 'object') return null;\nconst t = Number(p.temperatura);\nconst h = Number(p.humedad);\nif (isNaN(t) || isNaN(h)) return null;\n\nconst total = (context.get('total') || 0) + 1;\ncontext.set('total', total);\nconst hora = new Date().toLocaleTimeString('es-PE', { timeZone: 'America/Lima' });\n\n// Lecturas imposibles para un DHT (sensor mal leído): se descartan y se avisa\nif (t < -20 || t > 60 || h < 0 || h > 100) {\n    node.warn('Lectura descartada: T=' + t + ' H=' + h);\n    return [null, null, null,\n        { payload: { online: true, disp: p.dispositivo, hora: hora, n: total, aviso: 'Lectura fuera de rango descartada (T=' + t + ' °C). Revisen el sensor.' } },\n        null];\n}\n\nlet s = context.get('s') || { n: 0, tmin: t, tmax: t, tsum: 0, hmin: h, hmax: h, hsum: 0 };\ns.n++;\ns.tmin = Math.min(s.tmin, t); s.tmax = Math.max(s.tmax, t); s.tsum += t;\ns.hmin = Math.min(s.hmin, h); s.hmax = Math.max(s.hmax, h); s.hsum += h;\ncontext.set('s', s);\n\nconst umbral = flow.get('umbral') ?? 30;\nconst enAlerta = t > umbral;\nlet aviso = null;\nif (enAlerta && !context.get('alertaActiva')) {\n    aviso = { payload: 'Temperatura alta: ' + t.toFixed(1) + ' °C (umbral ' + umbral + ' °C)' };\n}\ncontext.set('alertaActiva', enAlerta);\nreturn [\n    { payload: { v: t, min: s.tmin, avg: s.tsum / s.n, max: s.tmax, umbral: umbral, alerta: enAlerta } }, // 1 tarjeta temperatura\n    { payload: { v: h, min: s.hmin, avg: s.hsum / s.n, max: s.hmax } },                                   // 2 tarjeta humedad\n    [ { topic: 'Temperatura (°C)', payload: t }, { topic: 'Humedad (%)', payload: h } ],                  // 3 gráfico\n    { payload: { online: true, disp: p.dispositivo, hora: hora, n: total } },                             // 4 encabezado\n    aviso                                                                                                 // 5 notificación\n];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
