        "name": "Tarjeta temperatura",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"eq2-card\" :class=\"{ alert: d && d.alerta }\">\n    <div class=\"eq2-row\">\n      <span class=\"eq2-label\"><v-icon icon=\"mdi-thermometer\" size=\"18\"></v-icon>TEMPERATURA</span>\n      <span v-if=\"d && d.alerta\" class=\"eq2-badge\">SOBRE EL UMBRAL</span>\n    </div>\n    <div class=\"eq2-val\">{{ d ? d.v.toFixed(1) : '—' }}<span class=\"eq2-unit\">°C</span></div>\n    <div class=\"eq2-track\">\n      <div class=\"eq2-fill temp\" :style=\"{ width: pct + '%' }\"></div>\n      <div v-if=\"d && d.umbral != null\" class=\"eq2-mark\" :style=\"{ left: markPct + '%' }\" title=\"Umbral de alerta\"></div>\n    </div>\n    <div class=\"eq2-scale\"><span>0</span><span>45 °C</span></div>\n    <div class=\"eq2-stats\">\n      <span>mín <b>{{ d ? d.min.toFixed(1) : '—' }}</b></span>\n      <span>prom <b>{{ d ? d.avg.toFixed(1) : '—' }}</b></span>\n      <span>máx <b>{{ d ? d.max.toFixed(1) : '—' }}</b></span>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  computed: {\n    d () { const p = this.msg && this.msg.payload; return (p && typeof p.v === 'number') ? p : null },\n    pct () { return this.d ? Math.max(0, Math.min(100, this.d.v / 45 * 100)) : 0 },\n    markPct () { return this.d ? Math.max(0, Math.min(100, this.d.umbral / 45 * 100)) : 0 }\n  }\n}\n</script>",
