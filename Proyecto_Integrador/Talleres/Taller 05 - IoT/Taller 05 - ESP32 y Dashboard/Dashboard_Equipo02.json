    {
        "id": "906df737bf6dcaae",
        "type": "ui-template",
        "z": "fead62247fb3efa1",
        "group": "3425e70e0bc27953",
        "page": "",
        "ui": "",
        "name": "Encabezado",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"eq2-card\">\n    <div class=\"eq2-row\">\n      <div style=\"display:flex;align-items:center\">\n        <img v-if=\"fotoUrl && fotoOk\" class=\"eq2-foto\" :src=\"fotoUrl\" alt=\"Foto del equipo\" @error=\"fotoOk = false\">\n        <div>\n          <div class=\"eq2-title\">Equipo 02</div>\n          <div class=\"eq2-sub\">Estación de temperatura y humedad · ESP32 + DHT11 · MQTT</div>\n        </div>\n      </div>\n      <div style=\"display:flex;align-items:center\">\n        <div>\n          <div style=\"text-align:right\">\n            <div class=\"eq2-pill\" :class=\"estado\">\n              <span class=\"dot\"></span>{{ estado === 'on' ? 'EN LÍNEA' : (estado === 'off' ? 'SIN SEÑAL' : 'ESPERANDO DATOS') }}\n            </div>\n          </div>\n          <div class=\"eq2-meta\" v-if=\"estado === 'on'\">{{ s.disp }} · última lectura {{ s.hora }} · {{ s.n }} lecturas</div>\n          <div class=\"eq2-meta eq2-warn\" v-if=\"estado === 'on' && s.aviso\">{{ s.aviso }}</div>\n          <div class=\"eq2-meta\" v-else-if=\"estado === 'off'\">Sin datos hace más de 15 s</div>\n        </div>\n        <img v-if=\"logoUrl && logoOk\" class=\"eq2-logo\" :src=\"logoUrl\" alt=\"Logo\" @error=\"logoOk = false\">\n      </div>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data () {\n    return {\n      // ====== IMÁGENES: cambia solo estas dos líneas ======\n      fotoUrl: 'https://raw.githubusercontent.com/Joseph-L-Q/PI_Equipo_02/main/Recursos/Im%C3%A1genes/Grupo2.png',\n      logoUrl: '',   // pega aquí, entre las comillas, la URL del logo (debe terminar en .png, .jpg o .svg)\n      // ====================================================\n      fotoOk: true,\n      logoOk: true\n    }\n  },\n  computed: {\n    s () { return (this.msg && this.msg.payload && typeof this.msg.payload === 'object') ? this.msg.payload : null },\n    estado () { return this.s ? (this.s.online ? 'on' : 'off') : 'wait' }\n  }\n}\n</script>\n<style>\n.eq2-card { background:#1b2130; border:1px solid #2c3446; border-radius:12px; padding:16px 18px; color:#e6e9ef; }\n.eq2-muted { color:#8d97ab; }\n.eq2-label { font-size:.78rem; font-weight:700; letter-spacing:1.4px; color:#8d97ab; display:flex; align-items:center; gap:6px; }\n.eq2-row { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }\n.eq2-val { font-size:3.4rem; font-weight:700; line-height:1.05; margin:10px 0 12px; font-variant-numeric:tabular-nums; }\n.eq2-unit { font-size:1.3rem; font-weight:500; color:#8d97ab; margin-left:6px; }\n.eq2-track { position:relative; height:12px; border-radius:6px; background:#2c3446; overflow:visible; }\n.eq2-fill { height:100%; border-radius:6px; transition:width .8s ease; }\n.eq2-fill.temp { background:linear-gradient(90deg,#fbbf24,#f97316); }\n.eq2-fill.hum { background:linear-gradient(90deg,#2dd4bf,#38bdf8); }\n.eq2-mark { position:absolute; top:-5px; width:2px; height:22px; background:#f87171; }\n.eq2-scale { display:flex; justify-content:space-between; font-size:.72rem; color:#8d97ab; margin-top:6px; }\n.eq2-stats { display:flex; gap:18px; margin-top:12px; font-size:.86rem; color:#8d97ab; }\n.eq2-stats b { color:#e6e9ef; font-weight:600; }\n.eq2-badge { font-size:.7rem; font-weight:700; letter-spacing:1px; padding:3px 9px; border-radius:20px; background:#f87171; color:#1b2130; }\n.eq2-card.alert { border-color:#f87171; }\n.eq2-title { font-size:1.45rem; font-weight:700; }\n.eq2-sub { font-size:.88rem; color:#8d97ab; margin-top:2px; }\n.eq2-pill { display:inline-flex; align-items:center; gap:8px; font-size:.8rem; font-weight:700; letter-spacing:1px; padding:6px 14px; border-radius:20px; background:#2c3446; color:#8d97ab; }\n.eq2-pill .dot { width:9px; height:9px; border-radius:50%; background:#8d97ab; }\n.eq2-pill.on { background:rgba(45,212,191,.14); color:#2dd4bf; }\n.eq2-pill.on .dot { background:#2dd4bf; box-shadow:0 0 0 0 rgba(45,212,191,.6); animation:eq2pulse 1.6s infinite; }\n.eq2-pill.off { background:rgba(248,113,113,.14); color:#f87171; }\n.eq2-pill.off .dot { background:#f87171; }\n@keyframes eq2pulse { 0%{box-shadow:0 0 0 0 rgba(45,212,191,.55)} 70%{box-shadow:0 0 0 9px rgba(45,212,191,0)} 100%{box-shadow:0 0 0 0 rgba(45,212,191,0)} }\n.eq2-meta { font-size:.82rem; color:#8d97ab; text-align:right; margin-top:6px; }\n.eq2-logo { height:44px; margin-right:14px; border-radius:6px; }\n.eq2-led { display:flex; align-items:center; gap:16px; }\n.eq2-bulb { width:64px; height:64px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#2c3446; color:#8d97ab; transition:all .25s ease; }\n.eq2-bulb.on { background:#fbbf24; color:#1b2130; box-shadow:0 0 24px 6px rgba(251,191,36,.55); }\n.eq2-led-state { font-size:1.25rem; font-weight:700; }\n.eq2-led-state.on { color:#fbbf24; }\n\n/* Oculta los grupos vacíos de versiones anteriores */\n#nrdb-ui-group-10bda0b25743b4f3,\n#nrdb-ui-group-v3_g_head,\n#nrdb-ui-group-v3_g_hum,\n#nrdb-ui-group-v3_g_ctl,\n#nrdb-ui-group-v3_g_est,\n#nrdb-ui-group-v3_g_hist,\n#nrdb-ui-group-v3_g_alr,\n#nrdb-ui-group-grp_head_eq2,\n#nrdb-ui-group-grp_estado_eq2,\n#nrdb-ui-group-grp_ctl_eq2,\n#nrdb-ui-group-grp_hist_eq2,\n#nrdb-ui-group-grp_stats_eq2 { display:none !important; }\n/* Foto y logo del encabezado */\n.eq2-foto { height:64px; max-width:180px; object-fit:cover; border-radius:10px; margin-right:16px; border:1px solid #2c3446; }\n.eq2-logo { height:48px; margin-left:18px; }\n.eq2-warn { color:#fbbf24; }\n</style>",
